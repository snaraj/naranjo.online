{
  "compilerOptions": {
    "allowJs": true,
    // Node's type-stripping test runner resolves import specifiers literally,
    // so a value import between two src modules must carry its extension for
    // `node --test` to load it at all. noEmit is on and the bundler resolves
    // the same specifier, so the extension is free everywhere else.
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    // The model vocabulary is DATA in one file that all three consumers read
    // (issue #302); this is what lets src/lib import those bytes rather than
    // keep a fourth copy of them.
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2023"
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.svelte"]
}
