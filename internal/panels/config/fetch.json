{
  "hosts": ["secure.runescape.com", "github.com", "api.github.com", "api.anthropic.com", "api.openai.com"],
  "ttlMinutes": 1,
  "timeoutSeconds": 10,
  "maxBytes": 524288,
  "initialBackoffSeconds": 60,
  "maxBackoffMinutes": 15,
  "titles": { "boss-log": "Old School RuneScape", "vcs-activity": "GitHub", "coding-projects": "Coding Projects" },
  "bossLog": {
    "endpoint": "https://secure.runescape.com/m=hiscore_oldschool/index_lite.json?player=Roll+The+J",
    "account": "Roll The J",
    "maxBytes": 65536,
    "contentType": "application/json",
    "minIntervalMinutes": 15,
    "excludeActivities": [
      "Grid Points",
      "League Points",
      "Deadman Points",
      "Bounty Hunter - Hunter",
      "Bounty Hunter - Rogue",
      "Bounty Hunter (Legacy) - Hunter",
      "Bounty Hunter (Legacy) - Rogue",
      "Clue Scrolls (all)",
      "Clue Scrolls (beginner)",
      "Clue Scrolls (easy)",
      "Clue Scrolls (medium)",
      "Clue Scrolls (hard)",
      "Clue Scrolls (elite)",
      "Clue Scrolls (master)",
      "LMS - Rank",
      "PvP Arena - Rank",
      "Soul Wars Zeal",
      "Rifts closed",
      "Colosseum Glory",
      "Collections Logged"
    ]
  },
  "vcsActivity": {
    "endpoint": "https://github.com/users/snaraj/contributions",
    "headers": { "Accept": "text/html" },
    "maxBytes": 524288,
    "contentType": "text/html",
    "minIntervalMinutes": 15,
    "calendar": {
      "endpoint": "https://api.github.com/graphql",
      "query": "query($from: DateTime!, $to: DateTime!) { viewer { contributionsCollection(from: $from, to: $to) { contributionCalendar { totalContributions weeks { contributionDays { date contributionCount } } } } } }",
      "keyEnvName": "GITHUB_PANELS_TOKEN",
      "keyHeader": "Authorization",
      "keyPrefix": "Bearer ",
      "authenticatedMinIntervalMinutes": 1,
      "headers": { "Accept": "application/json", "Content-Type": "application/json" },
      "maxBytes": 262144,
      "contentType": "application/json"
    },
    "commits": {
      "owner": "snaraj",
      "keyEnvName": "GITHUB_PANELS_TOKEN",
      "keyHeader": "Authorization",
      "keyPrefix": "Bearer ",
      "minIntervalMinutes": 10,
      "authenticatedMinIntervalMinutes": 1,
      "max": 30,
      "contributions": {
        "endpoint": "https://api.github.com/graphql",
        "query": "query($from: DateTime!, $to: DateTime!) { viewer { id contributionsCollection(from: $from, to: $to) { totalCommitContributions commitContributionsByRepository(maxRepositories: 50) { repository { id name isPrivate owner { login } } contributions(first: 100, orderBy: {field: OCCURRED_AT, direction: DESC}) { nodes { occurredAt commitCount } } } } } }",
        "headers": { "Accept": "application/json", "Content-Type": "application/json" },
        "maxBytes": 262144,
        "contentType": "application/json"
      },
      "history": {
        "endpoint": "https://api.github.com/graphql",
        "query": "query($ids: [ID!]!, $author: ID!) { nodes(ids: $ids) { ... on Repository { name defaultBranchRef { target { ... on Commit { history(first: 10, author: {id: $author}) { nodes { oid messageHeadline committedDate } } } } } } } }",
        "headers": { "Accept": "application/json", "Content-Type": "application/json" },
        "maxBytes": 262144,
        "contentType": "application/json"
      }
    }
  },
  "codingProjects": {
    "account": "snaraj",
    "listingEndpoint": "https://api.github.com/users/snaraj/repos?per_page=30&sort=pushed",
    "repositories": {
      "endpoint": "https://api.github.com/graphql",
      "query": "query { viewer { pinnedItems(first: 6, types: REPOSITORY) { nodes { ... on Repository { name isPrivate } } } repositories(first: 50, ownerAffiliations: OWNER, privacy: PUBLIC, orderBy: {field: PUSHED_AT, direction: DESC}) { nodes { name description isPrivate stargazerCount pushedAt latestRelease { tagName } pullRequests(states: [MERGED, CLOSED]) { totalCount } } } } }",
      "headers": { "Accept": "application/json", "Content-Type": "application/json" },
      "maxBytes": 262144,
      "contentType": "application/json"
    },
    "exclude": [],
    "headers": { "Accept": "application/json" },
    "keyEnvName": "GITHUB_PANELS_TOKEN",
    "keyHeader": "Authorization",
    "keyPrefix": "Bearer ",
    "maxBytes": 262144,
    "contentType": "application/json",
    "minIntervalMinutes": 15,
    "authenticatedMinIntervalMinutes": 1
  },
  "tokenUsage": {
    "minIntervalMinutes": 5,
    "sources": [
      {
        "label": "anthropic",
        "endpoint": "https://api.anthropic.com/v1/organizations/usage_report/messages?bucket_width=1d&limit=31",
        "shape": "usage-report/v1",
        "keyEnvName": "ANTHROPIC_ADMIN_KEY",
        "keyHeader": "x-api-key",
        "keyPrefix": "",
        "headers": { "anthropic-version": "2023-06-01" },
        "maxBytes": 262144,
        "window": { "param": "starting_at", "format": "rfc3339", "lookbackDays": 30 }
      },
      {
        "label": "codex",
        "endpoint": "https://api.openai.com/v1/organization/usage/completions?bucket_width=1d&limit=31",
        "shape": "usage-page/v1",
        "keyEnvName": "OPENAI_ADMIN_KEY",
        "keyHeader": "Authorization",
        "keyPrefix": "Bearer ",
        "headers": {},
        "maxBytes": 262144,
        "window": { "param": "start_time", "format": "unix", "lookbackDays": 30 }
      }
    ]
  }
}
