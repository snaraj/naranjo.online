{
  "hosts": ["secure.runescape.com", "github.com", "api.github.com", "api.anthropic.com", "api.openai.com"],
  "ttlMinutes": 5,
  "timeoutSeconds": 10,
  "maxBytes": 524288,
  "initialBackoffSeconds": 60,
  "maxBackoffMinutes": 15,
  "titles": { "vcs-activity": "GitHub", "coding-projects": "Coding Projects" },
  "bossLog": {
    "endpoint": "https://secure.runescape.com/m=hiscore_oldschool/index_lite.json?player=Roll+The+J",
    "account": "Roll The J",
    "maxBytes": 65536,
    "contentType": "application/json",
    "minIntervalMinutes": 15,
    "excludeActivities": [
      "Grid Points",
      "League Points",
      "Deadman Points",
      "Bounty Hunter - Hunter",
      "Bounty Hunter - Rogue",
      "Bounty Hunter (Legacy) - Hunter",
      "Bounty Hunter (Legacy) - Rogue",
      "Clue Scrolls (all)",
      "Clue Scrolls (beginner)",
      "Clue Scrolls (easy)",
      "Clue Scrolls (medium)",
      "Clue Scrolls (hard)",
      "Clue Scrolls (elite)",
      "Clue Scrolls (master)",
      "LMS - Rank",
      "PvP Arena - Rank",
      "Soul Wars Zeal",
      "Rifts closed",
      "Colosseum Glory",
      "Collections Logged"
    ]
  },
  "vcsActivity": {
    "endpoint": "https://github.com/users/snaraj/contributions",
    "headers": { "Accept": "text/html" },
    "maxBytes": 524288,
    "contentType": "text/html",
    "minIntervalMinutes": 15,
    "calendar": {
      "endpoint": "https://api.github.com/graphql",
      "query": "query($from: DateTime!, $to: DateTime!) { viewer { contributionsCollection(from: $from, to: $to) { contributionCalendar { totalContributions weeks { contributionDays { date contributionCount } } } } } }",
      "keyEnvName": "GITHUB_PANELS_TOKEN",
      "keyHeader": "Authorization",
      "keyPrefix": "Bearer ",
      "headers": { "Accept": "application/json", "Content-Type": "application/json" },
      "maxBytes": 262144,
      "contentType": "application/json"
    },
    "commits": {
      "headers": { "Accept": "application/json" },
      "maxBytes": 262144,
      "contentType": "application/json",
      "minIntervalMinutes": 10,
      "max": 9,
      "sources": [
        {
          "repo": "naranjo.online",
          "endpoint": "https://api.github.com/repos/snaraj/naranjo.online/commits?per_page=3"
        },
        {
          "repo": "lidersea.com",
          "endpoint": "https://api.github.com/repos/snaraj/lidersea.com/commits?per_page=3"
        },
        {
          "repo": "website-infrastructure",
          "endpoint": "https://api.github.com/repos/snaraj/website-infrastructure/commits?per_page=3"
        }
      ]
    }
  },
  "codingProjects": {
    "headers": { "Accept": "application/json" },
    "keyEnvName": "GITHUB_PANELS_TOKEN",
    "keyHeader": "Authorization",
    "keyPrefix": "Bearer ",
    "maxBytes": 262144,
    "contentType": "application/json",
    "minIntervalMinutes": 15,
    "sources": [
      {
        "name": "naranjo.online",
        "endpoint": "https://api.github.com/repos/snaraj/naranjo.online",
        "pullsEndpoint": "https://api.github.com/search/issues?q=repo%3Asnaraj%2Fnaranjo.online+is%3Apr+is%3Aopen&per_page=1"
      },
      {
        "name": "website-infrastructure",
        "endpoint": "https://api.github.com/repos/snaraj/website-infrastructure",
        "pullsEndpoint": "https://api.github.com/search/issues?q=repo%3Asnaraj%2Fwebsite-infrastructure+is%3Apr+is%3Aopen&per_page=1"
      },
      {
        "name": "lidersea.com",
        "endpoint": "https://api.github.com/repos/snaraj/lidersea.com",
        "pullsEndpoint": "https://api.github.com/search/issues?q=repo%3Asnaraj%2Flidersea.com+is%3Apr+is%3Aopen&per_page=1"
      },
      {
        "name": "dotfiles",
        "endpoint": "https://api.github.com/repos/snaraj/dotfiles",
        "pullsEndpoint": "https://api.github.com/search/issues?q=repo%3Asnaraj%2Fdotfiles+is%3Apr+is%3Aopen&per_page=1"
      },
      {
        "name": "foobar2000-lyricsbuddy",
        "endpoint": "https://api.github.com/repos/snaraj/foobar2000-lyricsbuddy",
        "pullsEndpoint": "https://api.github.com/search/issues?q=repo%3Asnaraj%2Ffoobar2000-lyricsbuddy+is%3Apr+is%3Aopen&per_page=1"
      },
      {
        "name": "foobar2000-library-visualizer",
        "endpoint": "https://api.github.com/repos/snaraj/foobar2000-library-visualizer",
        "pullsEndpoint": "https://api.github.com/search/issues?q=repo%3Asnaraj%2Ffoobar2000-library-visualizer+is%3Apr+is%3Aopen&per_page=1"
      },
      {
        "name": "foobar2000-album-visualizer",
        "endpoint": "https://api.github.com/repos/snaraj/foobar2000-album-visualizer",
        "pullsEndpoint": "https://api.github.com/search/issues?q=repo%3Asnaraj%2Ffoobar2000-album-visualizer+is%3Apr+is%3Aopen&per_page=1"
      }
    ]
  },
  "tokenUsage": {
    "sources": [
      {
        "label": "anthropic",
        "endpoint": "https://api.anthropic.com/v1/organizations/usage_report/messages?bucket_width=1d&limit=31",
        "shape": "usage-report/v1",
        "keyEnvName": "ANTHROPIC_ADMIN_KEY",
        "keyHeader": "x-api-key",
        "keyPrefix": "",
        "headers": { "anthropic-version": "2023-06-01" },
        "maxBytes": 262144,
        "window": { "param": "starting_at", "format": "rfc3339", "lookbackDays": 30 }
      },
      {
        "label": "codex",
        "endpoint": "https://api.openai.com/v1/organization/usage/completions?bucket_width=1d&limit=31",
        "shape": "usage-page/v1",
        "keyEnvName": "OPENAI_ADMIN_KEY",
        "keyHeader": "Authorization",
        "keyPrefix": "Bearer ",
        "headers": {},
        "maxBytes": 262144,
        "window": { "param": "start_time", "format": "unix", "lookbackDays": 30 }
      }
    ]
  }
}
