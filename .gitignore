# Build outputs and local artifacts
frontend/node_modules/
internal/web/dist/*
!internal/web/dist/.gitkeep
coverage.out
*.cover.out
.DS_Store

# `make dev`'s locally built backend binary (see root Makefile)
/.dev-server

# Browser-lane leftovers (issue #26, stage 2). The engines themselves live in
# the operating system's user cache directory and never come near this tree;
# what a failed run can leave here is the per-test output directory.
frontend/test-results/

# Agent worktrees (see AGENTS.md, "Parallel agents in one checkout"). The
# tracked .claude/settings.json is deliberately not covered by this rule.
.claude/worktrees/
