{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "deploymentReady", "image", "service", "ingress", "media", "resources"],
  "definitions": {
    "cpuQuantity": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*m|[1-9][0-9]*(?:\\.[0-9]{1,3})?|0\\.(?:[1-9][0-9]{0,2}|0[1-9][0-9]?|00[1-9]))$"
    },
    "memoryQuantity": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:Ki|Mi|Gi|Ti|Pi|Ei|k|K|M|G|T|P|E)?$"
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"$ref": "#/definitions/cpuQuantity"},
        "memory": {"$ref": "#/definitions/memoryQuantity"}
      }
    }
  },
  "properties": {
    "replicaCount": {"type": "integer", "const": 2},
    "deploymentReady": {"type": "boolean"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "const": "ghcr.io/snaraj/naranjo-online"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["IfNotPresent", "Never"]}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {"port": {"type": "integer", "const": 8080}}
    },
    "ingress": {
      "type": "object",
      "description": "The deployment-provider binding point: identifies the only ingress peer allowed to reach the origin. The origin itself is provider-neutral and speaks standard HTTP; swapping edge providers is a values override here, never a template or code edit. All three fields are required, so the NetworkPolicy can never render a peer selector that names fewer facts than the peer identity needs.",
      "additionalProperties": false,
      "required": ["peerNamespace", "peerAppName", "peerInstance"],
      "properties": {
        "peerNamespace": {
          "type": "string",
          "description": "Namespace of the ingress connector's pods (DNS-1123 label).",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "peerAppName": {
          "type": "string",
          "description": "app.kubernetes.io/name label of the ingress connector's pods.",
          "pattern": "^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
        },
        "peerInstance": {
          "type": "string",
          "description": "app.kubernetes.io/instance label of the ingress connector's pods. Required and non-empty: the peer namespace holds several connectors sharing one app name, so this label is the fact that tells this site's connector from the others. Blank or absent fails validation rather than rendering a policy that admits every connector in that namespace.",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "profile"],
      "properties": {
        "enabled": {"type": "boolean", "const": false},
        "profile": {"type": "string", "const": "UNRESOLVED_PI_MEDIA_STORAGE"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resourcePair"},
        "limits": {"$ref": "#/definitions/resourcePair"}
      }
    }
  }
}
